# PV-Trace environment configuration
# Copy this file to .env and fill in your values

# openFDA API base URL (do not change unless targeting a mirror)
OPENFDA_BASE_URL=https://api.fda.gov/drug/event.json

# Hugging Face Inference API token (free tier, no billing required)
# Get yours at: https://huggingface.co → Settings → Access Tokens → New token (read)
HF_TOKEN=hf_your_token_here
